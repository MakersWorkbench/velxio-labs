  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "#include <SPI.h>                   // Load the SPI library\n\nconst byte OLED_CS = 10;           // Chip select, active low\nconst byte OLED_DC = 9;            // Data/command select: LOW means command byte, HIGH means pixel byte\nconst byte OLED_RES = 8;           // Reset, active low\n\n// Setup commands, each one defined in the SSD1306 datasheet.\nconst byte initCommands[] = {\n  0x8D, 0x14,                      // Charge pump setting: enable the charge pump\n  0x20, 0x00,                      // Memory addressing mode: horizontal\n  0x21, 0x00, 0x7F,                // Column address range: 0 to 127\n  0x22, 0x00, 0x07,                // Page address range: 0 to 7\n  0xAF                             // Display on\n};\n\nvoid setup() {\n  Serial.begin(115200);            // Report each frame over USB\n  pinMode(OLED_CS, OUTPUT);        // Chip select is an output\n  pinMode(OLED_DC, OUTPUT);        // Data/command select is an output\n  pinMode(OLED_RES, OUTPUT);       // Reset is an output\n  digitalWrite(OLED_CS, HIGH);     // Start deselected\n  SPI.begin();                     // Start the SPI controller (MOSI is D11, SCK is D13)\n\n  digitalWrite(OLED_RES, LOW);     // Hold the display in reset\n  delay(10);                       // Wait 10 milliseconds\n  digitalWrite(OLED_RES, HIGH);    // Release the reset\n  delay(10);                       // Give the display time to start\n\n  SPI.beginTransaction(SPISettings(4000000, MSBFIRST, SPI_MODE0)); // The display captures on the rising edge\n\n  digitalWrite(OLED_DC, LOW);      // The next bytes are commands\n  digitalWrite(OLED_CS, LOW);      // Frame 1 starts\n  for (byte i = 0; i < sizeof(initCommands); i++) {\n    SPI.transfer(initCommands[i]); // Send one command byte\n  }\n  digitalWrite(OLED_CS, HIGH);     // Frame 1 ends\n  Serial.print(\"Frame 1: \");       // Report how many command bytes went out\n  Serial.print(sizeof(initCommands));\n  Serial.println(\" command bytes\");\n\n  digitalWrite(OLED_DC, HIGH);     // The next bytes are pixel data\n  digitalWrite(OLED_CS, LOW);      // Frame 2 starts\n  for (byte page = 0; page < 8; page++) {          // The display has 8 pages of 8 pixel rows\n    for (byte column = 0; column < 128; column++) { // Each page has 128 columns\n      byte pixels = (column / 16 >= page) ? 0xFF : 0x00; // A staircase: one more step per page\n      SPI.transfer(pixels);        // Send one column of 8 pixels\n    }\n  }\n  digitalWrite(OLED_CS, HIGH);     // Frame 2 ends\n  Serial.println(\"Frame 2: 1024 pixel bytes\");\n\n  SPI.endTransaction();            // Release the bus\n}\n\nvoid loop() {\n  // The picture stays on the display. Nothing to repeat.\n}\n"
      }
    ]
  },
