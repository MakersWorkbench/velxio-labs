{"format": "velxio-project", "version": 1, "exportedAt": "2026-11-24T07:05:03.000Z", "name": "History-of-Serial-Communication-Frame-Echo-v2", "boards": [{"id": "arduino-uno", "boardKind": "arduino-uno", "x": 40, "y": 60, "activeFileGroupId": "group-arduino-uno", "languageMode": "arduino", "serialBaudRate": 0}], "fileGroups": {"group-arduino-uno": [{"name": "sketch.ino", "content": "const uint8_t LED_PIN = LED_BUILTIN;           // the Uno's onboard LED on pin 13 shows the line level\nconst unsigned long BIT_MS = 500;              // slow motion: one bit every half second so each bit is visible\nconst unsigned long BAUD = 9600;               // the real speed of the Serial Monitor connection\n\nvoid showBit(const char *name, uint8_t index, uint8_t level) {\n  digitalWrite(LED_PIN, level);                // HIGH is mark (logic 1, LED on), LOW is space (logic 0, LED off)\n  Serial.print(name);                          // print the bit's name: start, D, or stop\n  if (index < 8) {                             // data bits carry a number, D0 to D7\n    Serial.print(index);                       // print which data bit this is\n  }\n  Serial.print(F(\" = \"));                      // separator between the name and the value\n  Serial.println(level);                       // print the bit's value, 1 or 0\n  delay(BIT_MS);                               // hold this level for one slow bit time\n}\n\nvoid setup() {\n  Serial.begin(BAUD);                          // open the serial port at 9600 baud, 8 data bits, no parity, 1 stop bit\n  pinMode(LED_PIN, OUTPUT);                    // the LED pin drives the slow-motion line\n  digitalWrite(LED_PIN, HIGH);                 // an idle serial line sits at mark, so the LED is on\n  Serial.println(F(\"Type one character and press Send.\"));\n  Serial.print(F(\"At 9600 baud one real bit lasts about \"));\n  Serial.print(1000000UL / BAUD);              // 1,000,000 microseconds divided by bits per second\n  Serial.println(F(\" microseconds.\"));\n}\n\nvoid loop() {\n  if (Serial.available() > 0) {                // did a character arrive from the Serial Monitor?\n    char c = Serial.read();                    // read that one character\n    if (c == '\\n' || c == '\\r') {              // ignore the line ending the Send menu may add\n      return;\n    }\n    Serial.print(F(\"Received '\"));\n    Serial.print(c);                           // show the character itself\n    Serial.print(F(\"'  decimal \"));\n    Serial.print((uint8_t)c);                  // its ASCII code in decimal\n    Serial.print(F(\"  binary \"));\n    for (int8_t i = 7; i >= 0; i--) {          // print the 8 bits, most significant bit first\n      Serial.print((c >> i) & 1);              // shift bit i down to the lowest place and mask the rest\n    }\n    Serial.println();\n    Serial.println(F(\"Slow-motion frame (LED on = mark, LED off = space):\"));\n    showBit(\"start\", 8, 0);                    // the start bit is always space, so the LED goes off\n    for (uint8_t i = 0; i < 8; i++) {          // data bits go out least significant bit first\n      showBit(\"D\", i, (c >> i) & 1);           // send bit i of the character\n    }\n    showBit(\"stop\", 8, 1);                     // the stop bit is mark, so the LED comes back on\n    Serial.println(F(\"Line idle (mark). Type another character.\"));\n  }\n}\n"}]}, "components": [], "wires": [], "activeBoardId": "arduino-uno"}