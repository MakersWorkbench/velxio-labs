    "group-esp32-devkit-c-v4": [
      {
        "name": "sketch.ino",
        "content": "// Part 3: blink an external LED wired to GPIO 27 through a 220 ohm resistor.\n\nconst int kLedPin = 27;      // The GPIO number the resistor and LED are wired to. const means the value never changes.\n\nvoid setup() {\n  pinMode(kLedPin, OUTPUT);  // Make GPIO 27 an output so the sketch can drive it to 0V or 3.3V.\n}\n\nvoid loop() {\n  digitalWrite(kLedPin, HIGH);  // Drive the pin to 3.3V. Current flows through the resistor and LED, and the LED lights.\n  delay(1000);                  // Wait 1000 milliseconds (one second) with the LED on.\n  digitalWrite(kLedPin, LOW);   // Drive the pin to 0V. No current flows, and the LED goes dark.\n  delay(1000);                  // Wait one second with the LED off, then loop() starts again.\n}\n"
      }
    ]
  },
